{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cc-lime-passkeys",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "PASSKEY_ORIGIN": "", "PASSKEY_RP_ID": "", "FIREBASE_PROJECT_ID": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "cc-lime-passkeys", "database_id": "", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["0 * * * *"] }
}
