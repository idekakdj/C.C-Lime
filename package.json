{
  "name": "cc-lime",
  "productName": "C.C. Lime",
  "version": "0.1.0",
  "description": "A thoughtful calendar and task planner for university life.",
  "author": "idekakdj",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "scripts": {
    "start": "npm run build && node scripts/dev.mjs --production",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run check:secrets && npm run typecheck && npm test && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test:cloud": "node scripts/emulators.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/rebuild": "4.2.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/luxon": "3.7.5",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.2",
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.2",
    "ical.js": "2.2.1",
    "jose": "6.2.12",
    "jsdom": "29.1.1",
    "lucide-react": "1.47.0",
    "luxon": "3.7.2",
    "png-to-ico": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
